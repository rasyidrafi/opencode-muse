{
  "name": "@rasyid_rafi/opencode-muse",
  "version": "0.1.2",
  "description": "Run Muse Code inside OpenCode as a LanguageModelV3 provider",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "check": "tsc --noEmit -p tsconfig.json && bun test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@muse-code/sdk": "1.4.15",
    "@rasyid_rafi/opencode-agent-harness-core": "^0.1.0",
    "@opencode/plugin": "2.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "muse-code",
    "agent-harness",
    "adapter",
    "mcp"
  ]
}
